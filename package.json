{
  "name": "agentpay",
  "version": "1.0.0",
  "description": "AgentPay \u2014 agent payment policies orchestrated with Chainlink CRE",
  "main": "index.js",
  "scripts": {
    "test": "npm run test:contracts && npm run test:sdk && npm run test:server && npm run test:cre",
    "test:contracts": "npx hardhat test",
    "test:sdk": "npm --prefix sdk run test:all",
    "test:integration": "npm --prefix sdk run test:integration",
    "deploy:sepolia": "npx hardhat run scripts/deploy.js --network sepolia",
    "dev": "npm --prefix vite-project run dev",
    "build:web": "npm --prefix vite-project run build",
    "preview": "npm --prefix vite-project run preview",
    "install:all": "npm install && npm --prefix sdk install && npm --prefix server install && npm --prefix vite-project install",
    "demo:provider": "npx ts-node --project demo/tsconfig.json demo/provider.ts",
    "demo:consumer": "npx ts-node --project demo/tsconfig.json demo/consumer.ts",
    "demo:check": "npx ts-node --project demo/tsconfig.json demo/check-setup.ts",
    "test:server": "npm --prefix server test",
    "test:cre": "bun test --cwd cre/payment-guard",
    "install:cre": "bun install --cwd cre/payment-guard",
    "cre:simulate": "node scripts/simulate-cre.mjs",
    "cre:capture": "node scripts/simulate-cre.mjs --capture",
    "build:sdk": "npm --prefix sdk run build",
    "typecheck:cre": "cd cre/payment-guard && bun run typecheck",
    "deploy:guard": "npx hardhat run scripts/deploy-guard.js --network sepolia"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^6.1.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "hardhat": "^2.26.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "ethers": "^6.11.1",
    "express": "^4.18.2"
  }
}
