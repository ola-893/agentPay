{
  "name": "agentpay",
  "version": "1.0.0",
  "description": "AgentPay — deterministic payment guardrails for AI agents, built with Chainlink CRE",
  "main": "index.js",
  "scripts": {
    "test": "npm run test:contracts && npm run test:sdk && npm run test:server && npm run test:cre && npm run test:tooling",
    "test:contracts": "npx hardhat test",
    "test:sdk": "npm --prefix sdk run test:all",
    "test:integration": "npm --prefix sdk run test:integration",
    "deploy:sepolia": "npx hardhat run scripts/deploy.js --network sepolia",
    "dev": "npm --prefix vite-project run dev",
    "build:web": "npm --prefix vite-project run build",
    "preview": "npm --prefix vite-project run preview",
    "install:all": "npm install && npm --prefix sdk install && npm --prefix server install && npm --prefix vite-project install",
    "demo:provider": "npx ts-node --project demo/tsconfig.json demo/provider.ts",
    "demo:consumer": "npx ts-node --project demo/tsconfig.json demo/consumer.ts",
    "demo:check": "npx ts-node --project demo/tsconfig.json demo/check-setup.ts",
    "demo:agent": "node demo/agent-demo.mjs",
    "test:server": "npm --prefix server test",
    "test:cre": "bun test --cwd cre/payment-guard",
    "install:cre": "bun install --cwd cre/payment-guard",
    "cre:simulate": "node scripts/simulate-cre.mjs",
    "cre:capture": "node scripts/simulate-cre.mjs --capture",
    "build:sdk": "npm --prefix sdk run build",
    "typecheck:cre": "cd cre/payment-guard && bun run typecheck",
    "deploy:guard": "npx hardhat run scripts/deploy-guard.js --network sepolia",
    "cre:dry-run": "node scripts/preflight-cre.mjs",
    "test:tooling": "npm run build:sdk && node --test scripts/test/*.test.mjs",
    "deploy:cre-demo": "npx hardhat run scripts/deploy-cre-demo.js --network sepolia-demo",
    "cre:simulate:write": "node scripts/simulate-cre-write.mjs",
    "docs:check": "node scripts/check-docs.mjs && node scripts/check-doc-examples.mjs && node scripts/check-doc-evidence.mjs && bun run scripts/check-toolbuyer-evidence.mjs && bun run scripts/check-spend-evidence.mjs && node scripts/check-run-captures.mjs && node scripts/check-guarded-proof.mjs && node video/scripts/build-data.mjs --check && node scripts/check-video-source.mjs && node scripts/check-readiness-evidence.mjs",
    "deploy:usdc-stream": "node scripts/deploy-usdc-stream.mjs",
    "demo:toolbuyer": "bun run demo/toolbuyer.mjs",
    "deploy:decision-journal": "node scripts/deploy-decision-journal.mjs",
    "demo:spend-review": "bun run demo/spend-review.mjs",
    "dev:live": "node demo/dev-live.mjs",
    "demo:capture": "node scripts/capture-agent-run.mjs",
    "video:data": "node video/scripts/build-data.mjs && node video/scripts/write-script.mjs",
    "video:build": "node video/scripts/build-film.mjs",
    "video:preview": "cd video/agentpay-demo && npx --yes hyperframes@0.8.186 preview --background",
    "video:render": "cd video/agentpay-demo && npx --yes hyperframes@0.8.186 render --quality delivery --fps 30 --output ../out/agentpay-demo.mp4",
    "deploy:guarded-stream": "node scripts/deploy-guarded-stream.mjs",
    "recover:guarded-stream": "node scripts/recover-guarded-stream.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^6.1.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "hardhat": "^2.26.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "ethers": "^6.11.1",
    "express": "^4.18.2"
  }
}
