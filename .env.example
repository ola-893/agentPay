# Read-only CRE simulations do not require a wallet private key.
# Guarded USDC token/feed/6-decimal units are pinned in cre/payment-guard/config.staging.json.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Optional deployment settings. Keep blank until deploying your own testnet contracts.
PRIVATE_KEY=
ETHERSCAN_API_KEY=
CRE_FORWARDER_ADDRESS=
CRE_WORKFLOW_ID=

# Optional isolated Sepolia write demo. Never use a mainnet or production wallet.
# Both deployment and broadcast require this explicit opt-in.
ALLOW_SIMULATION_DEMO=false
DEMO_PRIVATE_KEY=

# Legacy streaming gateway/demo settings: configure newly deployed contracts.
# demo:check, demo:consumer and demo:agent use this dedicated test wallet (provider needs no key).
PRIVATE_KEY_1=
AGENTPAY_STREAM_ADDRESS=
PAYMENT_TOKEN_ADDRESS=
PAYMENT_RECIPIENT_ADDRESS=
PORT=3001

# Optional AI features in the legacy streaming SDK.
GEMINI_API_KEY=

# AI CLI agent demo. Keep these server-side; never use VITE_ for keys.
# Qwen is selected when its key is configured; set the provider explicitly to override.
AGENTPAY_AI_PROVIDER=
QWEN_API_KEY=
QWEN_MODEL=qwen3.5-plus
QWEN_REGION=singapore
# Optional official workspace-specific endpoint ending /compatible-mode/v1.
QWEN_BASE_URL=
# OPEN_AI_KEY is accepted as an alias for an existing local setup.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# A distinct recipient for test USDC. CRE_PAYMENT_RECIPIENT_ADDRESS is an alias.
AGENTPAY_AGENT_RECIPIENT=

# Override only if cre is not on PATH, e.g. /absolute/path/to/cre
# CRE_BIN=cre

# Separate six-decimal Circle USDC escrow stream for demo:agent (not the tUSD UI).
AGENTPAY_USDC_STREAM_ADDRESS=0x35f5F69A68D703d70e661b5a0fDe282B3c4dfA09

# Optional public address for ToolBuyer budget eligibility reads; no key/signing.
AGENTPAY_TOOLBUYER_PAYER=0xe26468ae02368a75DBDBea58F367B7313942ad26

# Local spend-review audit settings (never put these in VITE_ variables).
# Defaults to .local/audit/<payer> and the verified checked-in receipt deployment.
AGENTPAY_DECISION_JOURNAL_ADDRESS=0xa1A5BA33bebdDe7EcA55BDe252568C9D16C4Da87
# AGENTPAY_AUDIT_DIR=/absolute/path/to/durable-local-audit
# Public payer for unsigned standalone reviews; --anchor uses the configured wallet.
AGENTPAY_AUDIT_PAYER=0xe26468ae02368a75DBDBea58F367B7313942ad26
