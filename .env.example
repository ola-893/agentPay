# Read-only CRE simulations do not require a wallet private key.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Optional deployment settings. Keep blank until deploying your own testnet contracts.
PRIVATE_KEY=
ETHERSCAN_API_KEY=
CRE_FORWARDER_ADDRESS=
CRE_WORKFLOW_ID=

# Legacy streaming gateway/demo settings: configure newly deployed contracts.
AGENTPAY_STREAM_ADDRESS=
PAYMENT_TOKEN_ADDRESS=
PAYMENT_RECIPIENT_ADDRESS=
PORT=3001

# Optional AI features in the legacy streaming SDK.
GEMINI_API_KEY=

# Override only if cre is not on PATH, e.g. /absolute/path/to/cre
# CRE_BIN=cre
